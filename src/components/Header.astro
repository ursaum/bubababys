---
import { CATEGORIAS } from '../data/categorias';

const atual = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">👶 Bubababys</a>
    <nav class="nav-principal" aria-label="Navegação principal">
      {
        CATEGORIAS.map((cat) => (
          <a
            href={`/categoria/${cat.slug}/`}
            class={atual.startsWith(`/categoria/${cat.slug}`) ? 'ativo' : ''}
          >
            {cat.nome}
          </a>
        ))
      }
      <a href="/sobre/" class={atual.startsWith('/sobre') ? 'ativo' : ''}>Sobre</a>
    </nav>
  </div>
</header>
